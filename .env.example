# Fournisseur IA actif : openai | anthropic | gemini | deepseek
AI_PROVIDER=gemini

# Identifiant du modèle à utiliser
AI_MODEL=gemini-2.5-flash

# Clés API — renseigner uniquement celle du fournisseur choisi
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── Firebase (config web publique) ──────────────────────────────────────────
# Disponible dans Firebase Console → Paramètres du projet → Vos applications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
